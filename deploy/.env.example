# Copy to deploy/.env and fill in. Never commit the real .env.

# Public hostname. A real domain (DNS A record -> this machine, ports 80/443 open) gets a Let's Encrypt cert.
# `localhost` or a LAN IP (e.g. 192.168.1.20) gets a cert from Caddy's internal CA instead.
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=30m

# Inference (defaults are the production choice: clean-split 320px student + our whisper-small Urdu fine-tune).
# MODEL_PATH=./models/student_clean_res320_s2_notlesion.pth
# IMG_SIZE=320
# ASR_MODEL_PATH=./models/asr/whisper-small-urdu-ours
INFERENCE_THREADS=4
INFERENCE_MEM_LIMIT=4g
INFERENCE_TIMEOUT_MS=60000
