# SkinSense reverse proxy + static PWA host.
# DOMAIN decides the certificate: a public domain gets a Let's Encrypt cert automatically; `localhost` or a LAN IP
# gets one from Caddy's internal CA (browsers/phones must trust it, see deploy/README.md).
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self)"
		# Cross-origin isolation lets ONNX Runtime run multi-threaded WebAssembly (Whisper on the phone is several
		# times faster). "credentialless" still loads cross-origin map tiles; browsers without it fall back to 1 thread.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
		-Server
	}

	# Image uploads are capped at 10 MB and audio at 25 MB by multer; leave headroom for multipart overhead.
	request_body {
		max_size 30MB
	}

	handle /api/* {
		reverse_proxy api:5000
	}

	# Grad-CAM overlays are written by the inference service (UUID file names).
	handle /heatmaps/* {
		reverse_proxy inference:5001
	}

	handle {
		root * /srv

		# The service worker, its registration script, the manifest and the HTML shell must revalidate on every
		# load, or clients keep running an old build.
		@revalidate path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @revalidate Cache-Control "no-cache"

		# Content-hashed build output and versioned model files never change under the same URL.
		@immutable path /assets/* /models/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		# Go's MIME table has no entry for ONNX model files.
		@onnx path *.onnx *.onnx_data
		header @onnx Content-Type "application/octet-stream"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
